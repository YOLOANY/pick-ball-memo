<!--pages/settings/help.wxml-->
<view class="page">

  <view class="section-title">常见问题</view>
  <view class="faq-card">
    <view class="faq-item" wx:for="{{faqs}}" wx:key="q">
      <view class="faq-q">{{item.q}}</view>
      <view class="faq-a">{{item.a}}</view>
    </view>
  </view>

  <view class="section-title">联系我们</view>
  <view class="feedback">
    <view class="feedback-title">遇到问题或有建议？</view>
    <view class="feedback-sub">我们重视每一条反馈,通常 1-3 天内会回复</view>
    <view class="feedback-actions">
      <view class="fb-btn fb-btn--ghost" bindtap="onCopyEmail">📧 复制邮箱</view>
      <view class="fb-btn fb-btn--primary" bindtap="onOpenFeedback">✍️ 写反馈</view>
    </view>
  </view>

</view>

/* pages/equipment/detail.wxss */
page { background-color: #F4F8F6; }
.page { min-height: 100vh; padding-bottom: 220rpx; }
.loading { text-align: center; padding: 200rpx 0; color: #B0BBB8; font-size: 28rpx; }

.cover { width: 100%; height: 480rpx; background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); display: flex; align-items: center; justify-content: center; position: relative; }
.cover-img { width: 100%; height: 100%; }
.cover-emoji { font-size: 200rpx; }
.cover-tag { position: absolute; top: 32rpx; left: 32rpx; padding: 10rpx 24rpx; font-size: 24rpx; font-weight: 500; border-radius: 28rpx; letter-spacing: 2rpx; }
.cover-tag--rent { background-color: #E8F4EE; color: #3D8C72; }
.cover-tag--sell { background-color: #FFF7E6; color: #C77A1F; }

.card { margin: -40rpx 32rpx 0; padding: 28rpx 32rpx; background-color: #ffffff; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06); position: relative; z-index: 1; }
.card + .card { margin-top: 24rpx; }

.name { font-size: 36rpx; font-weight: 600; color: #1F2A28; }
.meta { margin-top: 12rpx; font-size: 24rpx; color: #6B7875; }
.price-row { margin-top: 20rpx; display: flex; align-items: baseline; gap: 8rpx; flex-wrap: wrap; }
.price-num { font-size: 44rpx; color: #E15A5A; font-weight: 700; }
.price-unit { font-size: 24rpx; color: #B0BBB8; }
.original { font-size: 24rpx; color: #B0BBB8; text-decoration: line-through; margin-left: 16rpx; }
.deposit { font-size: 24rpx; color: #6B7875; margin-left: 16rpx; }

/* ============ 议价成交后的价格行 ============ */
.price-num--deal { color: #E15A5A; }
/* 挂牌价降级成划线小字，让用户一眼看出「便宜了多少」 */
.price-struck { font-size: 26rpx; color: #B0BBB8; text-decoration: line-through; margin-left: 12rpx; }
.deal-tag { margin-left: 12rpx; padding: 4rpx 14rpx; font-size: 20rpx; color: #C77A1F; background-color: #FFF7E6; border-radius: 20rpx; }
.buy-modal-deal { margin-left: 12rpx; font-size: 22rpx; color: #C77A1F; }

/* ============ 发布者：收到的咨询入口 ============ */
.card--tap { padding-top: 24rpx; padding-bottom: 24rpx; }
.card-hover { background-color: #F7FBF9; }
.chat-entry { display: flex; align-items: center; }
.chat-entry-main { flex: 1; min-width: 0; }
.chat-entry-main .card-title { margin-bottom: 10rpx; }
.chat-entry-right { display: flex; align-items: center; gap: 12rpx; }
.chat-count { min-width: 40rpx; height: 40rpx; line-height: 40rpx; padding: 0 12rpx; text-align: center; font-size: 24rpx; color: #ffffff; background-color: #E15A5A; border-radius: 20rpx; }
.chat-count--zero { color: #B0BBB8; background-color: #F1F3F2; }
.arrow { font-size: 36rpx; color: #C9D2D0; line-height: 1; }

.card-title { font-size: 28rpx; font-weight: 600; color: #1F2A28; margin-bottom: 20rpx; padding-left: 12rpx; border-left: 8rpx solid #5BAE92; line-height: 1; }
.desc { font-size: 28rpx; color: #4A5856; line-height: 1.7; }

.creator { display: flex; align-items: center; gap: 20rpx; }
.creator-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background-color: #EEF2F0; }
.creator-info { flex: 1; }
.creator-name { font-size: 30rpx; font-weight: 500; color: #1F2A28; }
.creator-time { margin-top: 6rpx; font-size: 22rpx; color: #B0BBB8; }
.contact { margin-top: 20rpx; padding: 16rpx; background-color: #F4F8F6; border-radius: 12rpx; font-size: 26rpx; color: #5BAE92; }
.hint { font-size: 26rpx; color: #6B7875; padding: 8rpx 0; }

.bottom-spacer { height: 160rpx; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background-color: #ffffff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05); display: flex; gap: 20rpx; }
.btn { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 30rpx; border-radius: 44rpx; font-weight: 500; letter-spacing: 2rpx; margin: 0; }
/* 三个按钮并排时，「我的」「议价」压窄，把宽度留给主按钮 */
.btn--narrow { flex: 0 0 auto; padding: 0 26rpx; font-size: 28rpx; letter-spacing: 0; }
.btn::after { border: none; }
.btn--primary { background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; box-shadow: 0 6rpx 16rpx rgba(91, 174, 146, 0.3); }
.btn--secondary { background-color: #ffffff; color: #5BAE92; border: 2rpx solid #5BAE92; }
.btn--disabled { background-color: #F1F3F2; color: #B0BBB8; }

/* 购买弹窗 */
.buy-modal-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0,0,0,0.5); z-index: 100; display: flex; align-items: flex-end; }
.buy-modal { width: 100%; background-color: #ffffff; border-top-left-radius: 32rpx; border-top-right-radius: 32rpx; padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom)); box-shadow: 0 -8rpx 24rpx rgba(0,0,0,0.1); }
.buy-modal-title { font-size: 34rpx; font-weight: 600; color: #1F2A28; margin-bottom: 8rpx; }
.buy-modal-amount { font-size: 28rpx; color: #6B7875; margin-bottom: 24rpx; }
.buy-modal-price { color: #E15A5A; font-size: 36rpx; font-weight: 700; }
.buy-field { padding: 20rpx 0; border-top: 2rpx solid #EEF2F0; }
.buy-label { display: block; font-size: 26rpx; color: #1F2A28; font-weight: 500; margin-bottom: 12rpx; }
.buy-input { width: 100%; font-size: 28rpx; color: #1F2A28; }
.buy-input--area { min-height: 80rpx; line-height: 1.6; }
.placeholder { color: #B0BBB8; }
.buy-modal-actions { display: flex; gap: 20rpx; margin-top: 24rpx; }
.buy-btn { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 30rpx; border-radius: 44rpx; font-weight: 500; margin: 0; }
.buy-btn::after { border: none; }
.buy-btn--primary { background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; }
.buy-btn--cancel { background-color: #F4F8F6; color: #6B7875; }

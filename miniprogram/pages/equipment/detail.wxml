<!--pages/equipment/detail.wxml-->
<view class="page" wx:if="{{equip}}">
  <view class="cover">
    <image wx:if="{{equip.coverUrl}}" class="cover-img" src="{{equip.coverUrl}}" mode="aspectFill"></image>
    <view wx:else class="cover-emoji">{{equip.categoryEmoji}}</view>
    <view class="cover-tag {{equip.isSell ? 'cover-tag--sell' : 'cover-tag--rent'}}">{{equip.tradeTypeLabel}}</view>
  </view>

  <view class="card">
    <view class="name">{{equip.name}}</view>
    <view class="meta">🏷️ {{equip.categoryLabel}} · {{equip.condition}}</view>
    <!-- 议价谈成时：主价格换成议定价，挂牌价降级为划线价 -->
    <view class="price-row" wx:if="{{dealPrice > 0}}">
      <text class="price-num price-num--deal">{{dealPriceText}}</text>
      <text class="price-struck">{{equip.priceText}}{{equip.priceUnit}}</text>
      <text class="deal-tag">已议价</text>
      <text class="deposit" wx:if="{{!equip.isSell && equip.deposit > 0}}">押金 ¥{{equip.deposit}}</text>
    </view>
    <view class="price-row" wx:else>
      <text class="price-num">{{equip.priceText}}</text>
      <text class="price-unit" wx:if="{{equip.priceUnit}}">{{equip.priceUnit}}</text>
      <text class="original" wx:if="{{equip.hasOriginal}}">{{equip.originalText}}</text>
      <text class="deposit" wx:if="{{!equip.isSell && equip.deposit > 0}}">押金 ¥{{equip.deposit}}</text>
    </view>
  </view>

  <view class="card" wx:if="{{equip.description}}">
    <view class="card-title">📝 详细描述</view>
    <view class="desc">{{equip.description}}</view>
  </view>

  <view class="card">
    <view class="card-title">👤 发布者</view>
    <view class="creator">
      <image class="creator-avatar" src="{{defaultAvatar}}"></image>
      <view class="creator-info">
        <view class="creator-name">{{equip.nickName}}</view>
        <view class="creator-time">发布于 {{equip.createdAtText}}</view>
      </view>
    </view>
    <view class="contact" wx:if="{{equip.contact}}">📱 {{equip.contact}}</view>
  </view>

  <!-- 发布者视角：收到的议价咨询入口 -->
  <view class="card card--tap" wx:if="{{isOwner}}" bindtap="onViewChats" hover-class="card-hover" hover-stay-time="80">
    <view class="chat-entry">
      <view class="chat-entry-main">
        <view class="card-title">💬 收到的咨询</view>
        <view class="hint">买家的议价消息都在这里，谈好后等对方下单</view>
      </view>
      <view class="chat-entry-right">
        <text class="chat-count" wx:if="{{chatCount > 0}}">{{chatCount}}</text>
        <text class="chat-count chat-count--zero" wx:else>0</text>
        <text class="arrow">›</text>
      </view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
  <view class="action-bar">
    <button class="btn btn--secondary btn--narrow" bindtap="onTapMy">我的</button>
    <block wx:if="{{isOwner}}">
      <button class="btn btn--disabled" disabled>自己发布的</button>
    </block>
    <block wx:elif="{{equip.isSell}}">
      <block wx:if="{{equip.status === 'available'}}">
        <button class="btn btn--secondary btn--narrow" bindtap="onChat">💬 议价</button>
        <button class="btn btn--primary" bindtap="onBuy" loading="{{submitting}}">{{dealPrice > 0 ? '按议定价下单' : '立即购买'}}</button>
      </block>
      <block wx:else>
        <button class="btn btn--disabled" disabled>已售出 / 已下架</button>
      </block>
    </block>
    <block wx:else>
      <block wx:if="{{equip.status === 'available'}}">
        <button class="btn btn--secondary btn--narrow" bindtap="onChat">💬 议价</button>
        <button class="btn btn--primary" bindtap="onBorrow" loading="{{submitting}}">{{dealPrice > 0 ? '按议定价下单' : '发起租借'}}</button>
      </block>
      <block wx:else>
        <button class="btn btn--disabled" disabled>暂不可借</button>
      </block>
    </block>
  </view>
</view>

<!-- 购买弹窗 -->
<view class="buy-modal-mask" wx:if="{{showBuyModal}}" bindtap="closeBuyModal">
  <view class="buy-modal" catchtap="">
    <view class="buy-modal-title">📦 填写购买信息</view>
    <view class="buy-modal-amount" wx:if="{{dealPrice > 0}}">
      金额：<text class="buy-modal-price">¥{{dealPrice}}</text>
      <text class="buy-modal-deal">已议价（原价 ¥{{equip.salePrice}}）</text>
    </view>
    <view class="buy-modal-amount" wx:else>金额：<text class="buy-modal-price">¥{{equip.salePrice}}</text></view>

    <view class="buy-field">
      <text class="buy-label">收货地址</text>
      <textarea class="buy-input buy-input--area" placeholder="请填写收货地址" placeholder-class="placeholder" value="{{buyForm.address}}" bindinput="onBuyInput" data-field="address" maxlength="100" auto-height />
    </view>
    <view class="buy-field">
      <text class="buy-label">联系电话</text>
      <input class="buy-input" type="number" placeholder="请填写联系电话" placeholder-class="placeholder" value="{{buyForm.phone}}" bindinput="onBuyInput" data-field="phone" maxlength="20" />
    </view>
    <view class="buy-field">
      <text class="buy-label">备注</text>
      <textarea class="buy-input buy-input--area" placeholder="选填，交易备注" placeholder-class="placeholder" value="{{buyForm.remark}}" bindinput="onBuyInput" data-field="remark" maxlength="200" auto-height />
    </view>

    <view class="buy-modal-actions">
      <button class="buy-btn buy-btn--cancel" bindtap="closeBuyModal">取消</button>
      <button class="buy-btn buy-btn--primary" bindtap="onConfirmBuy" loading="{{submitting}}">确认购买</button>
    </view>
  </view>
</view>

<view class="loading" wx:else>加载中…</view>

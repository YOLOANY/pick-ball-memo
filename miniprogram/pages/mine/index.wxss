/* pages/mine/index.wxss */
/* 配色沿用项目主题：主绿 #5BAE92 → #7DC9A8 渐变，底色 #F4F8F6，卡片白底 20rpx 圆角 + 柔和阴影
 * 布局约定：所有大模块统一 margin: 32rpx 32rpx 0，模块之间靠这一处间距控制 */
page { background-color: #F4F8F6; }
.page { min-height: 100vh; padding-bottom: 60rpx; }

/* ============ ① 头部资料 ============ */
.profile { position: relative; height: 360rpx; overflow: hidden; }
.profile-bg {
  position: absolute; top: 0; left: 0; right: 0; height: 280rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
}
.profile-content {
  position: relative;
  margin: 0 32rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
  text-align: center;
  transform: translateY(60rpx);
}
.profile-avatar { width: 140rpx; height: 140rpx; border-radius: 50%; background-color: #EEF2F0; border: 6rpx solid #ffffff; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.08); }
.profile-name { margin-top: 16rpx; font-size: 36rpx; font-weight: 600; color: #1F2A28; }
.profile-name--default { color: #B0BBB8; font-weight: 400; }
.profile-id { margin-top: 8rpx; font-size: 22rpx; color: #B0BBB8; }
.profile-id--hint { color: #5BAE92; }
.profile-btn {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  border-radius: 28rpx;
  padding: 0 32rpx;
  line-height: 56rpx;
}

/* ============ ② 数据统计 ============ */
/* 130rpx 上边距：抵消 .profile-content 的 translateY(60rpx)，让统计卡贴在资料卡下方 */
.stats {
  margin: 130rpx 32rpx 0;
  padding: 32rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
/* min-width: 0 —— 四格等分，标签再长也不会把卡片撑破 */
.stats-item { flex: 1 1 0; min-width: 0; text-align: center; }
.stats-num { font-size: 42rpx; font-weight: 700; color: #1F2A28; line-height: 1.2; }
.stats-label { margin-top: 8rpx; font-size: 22rpx; color: #6B7875; white-space: nowrap; }
.stats-divider { flex-shrink: 0; width: 2rpx; height: 56rpx; background-color: #EEF2F0; }

/* ============ ③ 快捷入口 ============ */
.quick {
  margin: 32rpx 32rpx 0;
  padding: 28rpx 20rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  display: flex;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.quick-item { flex: 1 1 0; min-width: 0; text-align: center; padding: 12rpx 0; border-radius: 16rpx; }
.quick-item--hover { background-color: #F4F8F6; }
.quick-icon { position: relative; display: inline-block; font-size: 52rpx; line-height: 1.2; }
/* 议价未读角标：挂在图标右上角，relative + absolute 定位，不影响图标居中 */
.quick-badge { position: absolute; top: -4rpx; right: -20rpx; min-width: 32rpx; height: 32rpx; line-height: 32rpx; padding: 0 8rpx; text-align: center; font-size: 20rpx; color: #ffffff; background-color: #E15A5A; border-radius: 16rpx; }
.quick-text { margin-top: 12rpx; font-size: 25rpx; color: #4A5856; white-space: nowrap; }

/* ============ ④ 运动偏好 ============ */
/* 视觉权重：整块加浅绿描边 + 淡绿渐变底，标题加左侧绿色竖条，和普通白卡区分开 */
.prefs {
  margin: 32rpx 32rpx 0;
  padding: 32rpx 28rpx;
  background: linear-gradient(180deg, #F7FBF9 0%, #FFFFFF 42%);
  border: 2rpx solid #E2EFE9;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.prefs-head { display: flex; flex-direction: column; }
.prefs-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A28;
  line-height: 1.2;
  padding-left: 16rpx;
  border-left: 8rpx solid #5BAE92;
}
/* 副标题独占一行，不再挤在标题右侧被压成两行 */
.prefs-sub {
  margin-top: 12rpx;
  padding-left: 24rpx;
  font-size: 23rpx;
  color: #8B9694;
  line-height: 1.5;
}
.prefs-list {
  margin-top: 24rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}
.pref {
  padding: 14rpx 28rpx;
  background-color: #F1F6F4;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #4A5856;
  line-height: 1.2;
  transition: transform 0.15s, background 0.2s;
}
.pref:active { transform: scale(0.96); }
.pref--active {
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  font-weight: 500;
  box-shadow: 0 4rpx 12rpx rgba(91, 174, 146, 0.25);
}

/* ============ ⑤ 菜单列表 ============ */
.menu {
  margin: 32rpx 32rpx 0;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 32rpx;
  border-bottom: 2rpx solid #F1F5F3;
}
.menu-item:last-child { border-bottom: none; }
.menu-item--hover { background-color: #F4F8F6; }
.menu-icon { font-size: 36rpx; width: 56rpx; line-height: 1; flex-shrink: 0; }
.menu-text { flex: 1; min-width: 0; font-size: 28rpx; color: #1F2A28; margin-left: 4rpx; }
.menu-value {
  font-size: 26rpx;
  color: #8B9694;
  margin-right: 12rpx;
  max-width: 320rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
/* 未绑定：用主题绿弱提示，不引入新配色 */
.menu-value--warn { color: #5BAE92; }
.menu-arrow { font-size: 36rpx; color: #B0BBB8; line-height: 1; font-weight: 300; flex-shrink: 0; }

.bottom-spacer { height: 40rpx; }

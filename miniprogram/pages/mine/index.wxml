<!--pages/mine/index.wxml-->
<!--
  个人中心结构（自上而下）：
    ① 用户资料卡
    ② 数据统计（我的发布 / 我的约球 / 约球历史 / 我的租借）—— 纯展示，不承载跳转
    ③ 快捷入口（场地预约 / 我的出物 / 运动打卡）—— 只放"我的"相关页，全局页走底部 tab
    ④ 运动偏好（多选标签）
    ⑤ 菜单列表（约球历史 / 我的租借记录 / 帮助与反馈 / 绑定手机号 / 设置）
  去重原则：约球历史、租借记录等每个入口全页只出现一次，统一收在 ⑤ 菜单列表里
-->
<view class="page">

  <!-- ① 用户信息卡 -->
  <view class="profile">
    <view class="profile-bg"></view>
    <view class="profile-content">
      <image class="profile-avatar" src="{{userInfo.avatarUrl || defaultAvatar}}"></image>
      <view class="profile-name">
        <text wx:if="{{userInfo.nickName}}">{{userInfo.nickName}}</text>
        <text wx:else class="profile-name--default">点击登录</text>
      </view>
      <view class="profile-id" wx:if="{{userInfo._openid}}">ID: {{shortId}}</view>
      <view class="profile-id profile-id--hint" wx:else>登录后可发布动态 / 约球 / 租借</view>
      <button class="profile-btn" size="mini" bindtap="onTapProfile">{{userInfo._openid ? '更新资料' : '微信一键登录'}}</button>
    </view>
  </view>

  <!-- ② 数据统计：四格横向，纯数字展示 -->
  <view class="stats">
    <view class="stats-item">
      <view class="stats-num">{{stats.posts}}</view>
      <view class="stats-label">我的发布</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-num">{{stats.joined}}</view>
      <view class="stats-label">我的约球</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-num">{{stats.history}}</view>
      <view class="stats-label">约球历史</view>
    </view>
    <view class="stats-divider"></view>
    <view class="stats-item">
      <view class="stats-num">{{stats.borrows}}</view>
      <view class="stats-label">我的租借</view>
    </view>
  </view>

  <!-- ③ 快捷功能：只保留三个"我的"维度入口 -->
  <view class="quick">
    <view class="quick-item" bindtap="onNavVenueMy" hover-class="quick-item--hover" hover-stay-time="80">
      <view class="quick-icon">🏟️</view>
      <view class="quick-text">场地预约</view>
    </view>
    <view class="quick-item" bindtap="onNavEquipMy" hover-class="quick-item--hover" hover-stay-time="80">
      <view class="quick-icon">
        🎒
        <text class="quick-badge" wx:if="{{chatUnread > 0}}">{{chatUnread}}</text>
      </view>
      <view class="quick-text">我的出物</view>
    </view>
    <view class="quick-item" bindtap="onNavMomentList" hover-class="quick-item--hover" hover-stay-time="80">
      <view class="quick-icon">🏃</view>
      <view class="quick-text">运动打卡</view>
    </view>
  </view>

  <!-- ④ 运动偏好（多选，影响约球广场分类排序） -->
  <view class="prefs">
    <view class="prefs-head">
      <view class="prefs-title">🏃 运动偏好</view>
      <view class="prefs-sub">告诉我们你喜欢的运动，约球广场会优先展示</view>
    </view>
    <view class="prefs-list">
      <view
        class="pref {{item.isPreferred ? 'pref--active' : ''}}"
        wx:for="{{sportOptions}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onTogglePref"
      >
        <text>{{item.emoji}} {{item.label}}</text>
      </view>
    </view>
  </view>

  <!-- ⑤ 个人菜单列表 -->
  <view class="menu">
    <view class="menu-item" bindtap="onNavBallHistory" hover-class="menu-item--hover" hover-stay-time="80">
      <view class="menu-icon">📜</view>
      <view class="menu-text">约球历史</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onNavEquipBorrows" hover-class="menu-item--hover" hover-stay-time="80">
      <view class="menu-icon">🧾</view>
      <view class="menu-text">我的租借记录</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onNavHelp" hover-class="menu-item--hover" hover-stay-time="80">
      <view class="menu-icon">💬</view>
      <view class="menu-text">帮助与反馈</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onNavBindPhone" hover-class="menu-item--hover" hover-stay-time="80">
      <view class="menu-icon">📱</view>
      <view class="menu-text">绑定手机号</view>
      <view class="menu-value {{phoneBound ? '' : 'menu-value--warn'}}">{{phoneText}}</view>
      <view class="menu-arrow">›</view>
    </view>
    <view class="menu-item" bindtap="onNavSettings" hover-class="menu-item--hover" hover-stay-time="80">
      <view class="menu-icon">⚙️</view>
      <view class="menu-text">设置</view>
      <view class="menu-arrow">›</view>
    </view>
  </view>

  <view class="bottom-spacer"></view>
</view>

<!--pages/venue/my.wxml-->
<view class="page">
  <view class="banner">
    <view class="banner-title">📋 我的预约</view>
    <view class="banner-sub">共 {{list.length}} 条记录</view>
  </view>

  <view class="list" wx:if="{{list.length > 0}}">
    <view class="card" wx:for="{{list}}" wx:key="_id">
      <view class="card-head">
        <view class="card-name">{{item.venueName}}</view>
        <view class="card-status card-status--{{item.status}}">{{item.statusLabel}}</view>
      </view>
      <view class="card-info">
        <view class="info-row">📅 {{item.date}} {{item.timeSlot}}</view>
        <view class="info-row">⏱ {{item.hours}} 小时</view>
        <view class="info-row" wx:if="{{item.totalPrice > 0}}">💰 ¥{{item.totalPrice}}</view>
        <view class="info-row info-row--time">提交于 {{item.createdAtText}}</view>
      </view>
      <view class="card-foot" wx:if="{{item.status === 'pending'}}">
        <button class="btn-cancel" size="mini" bindtap="onCancel" data-id="{{item._id}}">取消预约</button>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-emoji">📭</view>
    <view class="empty-title">还没有预约记录</view>
    <view class="empty-sub">去场地列表预约一个吧</view>
  </view>
</view>

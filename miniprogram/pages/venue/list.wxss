/* pages/venue/list.wxss */
page { background-color: #F4F8F6; }
.page { min-height: 100vh; padding-bottom: 60rpx; }

.banner {
  margin: 24rpx 32rpx 12rpx;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18);
}
.banner-title { font-size: 38rpx; font-weight: 600; letter-spacing: 2rpx; }
.banner-sub { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }

.list { padding: 24rpx 32rpx; }

.card {
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}
.card:active { transform: scale(0.98); background-color: #FAFCFB; }

.card-head { display: flex; align-items: center; gap: 20rpx; }
.card-emoji { font-size: 60rpx; line-height: 1; flex-shrink: 0; }
.card-info { flex: 1; min-width: 0; }
.card-name { font-size: 30rpx; font-weight: 600; color: #1F2A28; }
.card-loc { margin-top: 8rpx; font-size: 24rpx; color: #6B7875; }

.card-price { text-align: right; flex-shrink: 0; }
.card-price-num { font-size: 32rpx; color: #E15A5A; font-weight: 700; }
.card-price-num--free { color: #3D8C72; }
.card-price-unit { font-size: 20rpx; color: #B0BBB8; margin-left: 4rpx; }

.card-foot {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #F1F5F3;
  font-size: 24rpx;
  color: #6B7875;
}
.card-arrow { margin-left: auto; color: #B0BBB8; font-size: 36rpx; line-height: 1; }
.tag { background-color: #F4F8F6; padding: 4rpx 14rpx; border-radius: 20rpx; }

.list-end { text-align: center; font-size: 24rpx; color: #B0BBB8; padding: 40rpx 0; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 120rpx 32rpx; }
.empty-emoji { font-size: 120rpx; opacity: 0.6; }
.empty-title { margin-top: 32rpx; font-size: 32rpx; color: #4A5856; font-weight: 500; }
.empty-sub { margin-top: 12rpx; font-size: 26rpx; color: #B0BBB8; }
.empty-btn {
  margin-top: 40rpx;
  padding: 0 60rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  font-size: 28rpx;
  border-radius: 40rpx;
}

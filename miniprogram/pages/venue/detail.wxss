/* pages/venue/detail.wxss */
page { background-color: #F4F8F6; }
.page { min-height: 100vh; padding-bottom: 220rpx; }
.loading { text-align: center; padding: 200rpx 0; color: #B0BBB8; font-size: 28rpx; }

.hero {
  margin: 24rpx 32rpx 0;
  padding: 40rpx 32rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  border-radius: 24rpx;
  text-align: center;
  box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18);
}
.hero-emoji { font-size: 100rpx; line-height: 1; }
.hero-name { margin-top: 16rpx; font-size: 36rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-tags { display: flex; justify-content: center; flex-wrap: wrap; gap: 12rpx; margin-top: 20rpx; }
.hero-tag { font-size: 24rpx; opacity: 0.92; background-color: rgba(255,255,255,0.18); padding: 6rpx 16rpx; border-radius: 20rpx; }

.card { margin: 24rpx 32rpx 0; padding: 28rpx 32rpx; background-color: #ffffff; border-radius: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }
.card-title { font-size: 28rpx; font-weight: 600; color: #1F2A28; margin-bottom: 20rpx; padding-left: 12rpx; border-left: 8rpx solid #5BAE92; line-height: 1; }

.desc { font-size: 28rpx; color: #4A5856; line-height: 1.7; }

.price-row { display: flex; align-items: baseline; }
.price-num { font-size: 56rpx; color: #E15A5A; font-weight: 700; }
.price-num--free { color: #3D8C72; }
.price-unit { font-size: 24rpx; color: #B0BBB8; margin-left: 8rpx; }

.field { display: flex; align-items: center; justify-content: space-between; min-height: 110rpx; padding: 24rpx 0; }
.field--column { flex-direction: column; align-items: stretch; }
.field--input { }
.field-label { font-size: 30rpx; color: #1F2A28; font-weight: 500; flex-shrink: 0; width: 160rpx; }
.field--column .field-label { width: 100%; margin-bottom: 16rpx; }
.field-value { flex: 1; display: flex; align-items: center; justify-content: flex-end; font-size: 30rpx; color: #1F2A28; }
.field-picker { flex: 1; }
.field-input { flex: 1; font-size: 30rpx; color: #1F2A28; text-align: right; }
.placeholder { color: #B0BBB8; font-size: 28rpx; }
.arrow { margin-left: 8rpx; color: #B0BBB8; font-size: 36rpx; line-height: 1; font-weight: 300; }
.divider { height: 2rpx; background-color: #EEF2F0; margin: 0 -32rpx; }

.stepper { display: flex; align-items: center; gap: 16rpx; }
.stepper-btn { width: 56rpx; height: 56rpx; line-height: 50rpx; text-align: center; font-size: 36rpx; color: #5BAE92; background-color: #E8F4EE; border-radius: 50%; font-weight: 500; }
.stepper-btn--disabled { color: #B0BBB8; background-color: #F1F5F3; }
.stepper-value { min-width: 100rpx; text-align: center; font-size: 28rpx; color: #1F2A28; font-weight: 500; }

.field-textarea { width: 100%; min-height: 120rpx; font-size: 28rpx; color: #1F2A28; line-height: 1.6; padding: 8rpx 0; }

.summary {
  margin: 32rpx 32rpx 0;
  padding: 24rpx 32rpx;
  background-color: #FFF7E6;
  border-left: 6rpx solid #F5B947;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.summary-label { font-size: 28rpx; color: #6B7875; }
.summary-num { font-size: 40rpx; color: #E15A5A; font-weight: 700; }
.summary-num--free { color: #3D8C72; }

.bottom-spacer { height: 160rpx; }
.action-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background-color: #ffffff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05); display: flex; gap: 20rpx; }
.btn { flex: 1; height: 88rpx; line-height: 88rpx; font-size: 30rpx; border-radius: 44rpx; font-weight: 500; letter-spacing: 2rpx; margin: 0; }
.btn::after { border: none; }
.btn--primary { background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; box-shadow: 0 6rpx 16rpx rgba(91, 174, 146, 0.3); }
.btn--secondary { background-color: #ffffff; color: #5BAE92; border: 2rpx solid #5BAE92; }

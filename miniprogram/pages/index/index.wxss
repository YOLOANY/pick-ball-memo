/**index.wxss**/

page {
  padding-top: 0;
  background-color: #F4F8F6;
  padding-bottom: 40rpx;
}

.container {
  font-family: PingFang SC;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* ============ Hero ============ */
.hero {
  width: 100%;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  text-align: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(91, 174, 146, 0.2);
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.92;
  letter-spacing: 1rpx;
}

.hero-tags {
  display: inline-flex;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.hero-tag {
  padding: 8rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx;
  font-size: 24rpx;
}

/* ============ 待办提醒（我需要赴约） ============ */
.upcoming {
  width: 92%;
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  /* 提醒栏背景：渐变 + 阴影，区别于普通模块 */
  background: linear-gradient(180deg, #FFF6E6 0%, #FFFBF2 100%);
  border-radius: 24rpx;
  padding: 24rpx 20rpx 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(225, 90, 90, 0.08);
  border: 2rpx solid rgba(225, 90, 90, 0.08);
}

/* 左右滑动的 swiper 容器：固定高度，避免 swiper 因内容自适应抖高 */
.upcoming-swiper {
  width: 100%;
  height: 200rpx;
}

.upcoming-swiper-item {
  /* swiper-item 默认宽 100%，加一点左右内边距让卡片不贴边 */
  padding: 0 4rpx;
  box-sizing: border-box;
  overflow: visible;
}

/* 当存在 2h 内极紧急项时 → 整个 section 增强警示色 */
.upcoming--has-critical {
  background: linear-gradient(180deg, #FFE8E8 0%, #FFF4F0 100%);
  border-color: rgba(225, 90, 90, 0.18);
  box-shadow: 0 8rpx 24rpx rgba(225, 90, 90, 0.12);
}

.upcoming-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 4rpx;
}

.upcoming-title {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #B33A1A;
}

.upcoming-bell {
  font-size: 32rpx;
  line-height: 1;
  display: inline-block;
  transform-origin: top center;
}

/* 极紧急时铃铛左右摇晃 */
.upcoming-bell--shake {
  animation: bell-shake 1.2s ease-in-out infinite;
}

@keyframes bell-shake {
  0%, 60%, 100% { transform: rotate(0deg); }
  10% { transform: rotate(18deg); }
  20% { transform: rotate(-16deg); }
  30% { transform: rotate(12deg); }
  40% { transform: rotate(-10deg); }
  50% { transform: rotate(6deg); }
}

.upcoming-count {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 32rpx;
  padding: 0 14rpx;
  background-color: #E15A5A;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: 600;
  border-radius: 16rpx;
  line-height: 1;
  letter-spacing: 1rpx;
}

.upcoming-more {
  font-size: 24rpx;
  color: #5BAE92;
  font-weight: 600;
  padding: 4rpx 8rpx;
}

.upcoming-card {
  display: flex;
  align-items: center;
  background-color: #ffffff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  gap: 20rpx;
  border-left: 6rpx solid #E8F4EE;  /* 默认绿色细条 = 不紧急 */
  transition: transform 0.15s;
}

/* <24h 紧急：橙色细条 */
.upcoming-card--urgent {
  border-left-color: #F5A623;
  background: linear-gradient(90deg, #FFF8EC 0%, #FFFFFF 40%);
}

/* <2h 极紧急：红色细条 + 脉动 */
.upcoming-card--critical {
  border-left-color: #E15A5A;
  background: linear-gradient(90deg, #FFEDED 0%, #FFFFFF 40%);
  box-shadow: 0 6rpx 20rpx rgba(225, 90, 90, 0.18);
  animation: card-pulse 2s ease-in-out infinite;
}

@keyframes card-pulse {
  0%, 100% {
    box-shadow: 0 6rpx 20rpx rgba(225, 90, 90, 0.18);
  }
  50% {
    box-shadow: 0 8rpx 28rpx rgba(225, 90, 90, 0.35);
  }
}

.upcoming-card:active {
  transform: scale(0.99);
}

.upcoming-card--critical:active {
  background: linear-gradient(90deg, #FFE0E0 0%, #FFFAFA 40%);
}

.upcoming-sport {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #E8F4EE;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.upcoming-card--urgent .upcoming-sport {
  background-color: #FFF1D6;
}

.upcoming-card--critical .upcoming-sport {
  background-color: #FFE0E0;
}

.upcoming-emoji-small {
  font-size: 44rpx;
  line-height: 1;
}

.upcoming-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.upcoming-line1 {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.upcoming-sport-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A28;
}

.upcoming-role {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.upcoming-role--creator {
  background-color: #E8F4EE;
  color: #3D8C72;
}

.upcoming-role--joiner {
  background-color: #FFF7E6;
  color: #C97B3A;
}

.upcoming-urgent-tag {
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  border-radius: 16rpx;
  font-weight: 600;
  background-color: #E15A5A;
  color: #ffffff;
  letter-spacing: 1rpx;
}

.upcoming-line2 {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #4A5856;
  overflow: hidden;
}

.upcoming-icon {
  font-size: 22rpx;
  flex-shrink: 0;
}

.upcoming-time,
.upcoming-loc {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.upcoming-time {
  max-width: 220rpx;
  flex-shrink: 0;
}

.upcoming-loc {
  flex: 1;
  min-width: 0;
}

.upcoming-countdown {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #6B7875;
  font-weight: 500;
}

.upcoming-countdown--urgent {
  color: #F5A623;
  font-weight: 700;
}

.upcoming-countdown--critical {
  color: #E15A5A;
  font-weight: 700;
  font-size: 24rpx;
  /* 倒计时配 1s 闪烁 */
  animation: countdown-blink 1.5s ease-in-out infinite;
}

@keyframes countdown-blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.55; }
}

.upcoming-arrow {
  font-size: 36rpx;
  color: #B0BBB8;
  font-weight: 300;
  line-height: 1;
  flex-shrink: 0;
}

/* ============ 待办提醒 · 空态 ============ */
.upcoming-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 20rpx 24rpx;
  text-align: center;
}

.upcoming-empty-emoji {
  font-size: 72rpx;
  line-height: 1;
  opacity: 0.7;
}

.upcoming-empty-title {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #8B5A1A;
}

.upcoming-empty-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #A07A4A;
  line-height: 1.5;
  max-width: 80%;
}

.upcoming-empty-btn {
  margin-top: 24rpx;
  padding: 16rpx 40rpx;
  background: linear-gradient(135deg, #E8A040 0%, #F5B95A 100%);
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 36rpx;
  box-shadow: 0 6rpx 16rpx rgba(232, 160, 64, 0.3);
}

.upcoming-empty-btn:active {
  transform: scale(0.96);
  opacity: 0.9;
}

/* ============ 模块入口 ============ */
.modules {
  width: 92%;
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.module-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.module-card:active {
  transform: scale(0.97);
  background-color: #FAFCFB;
}

.module-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.module-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A28;
}

.module-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6B7875;
}

/* ============ 底部 ============ */
.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0BBB8;
  letter-spacing: 1rpx;
}

.footer-line {
  margin: 4rpx 0;
}

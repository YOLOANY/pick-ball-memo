/**index.wxss**/

page {
  padding-top: 0;
  background-color: #F4F8F6;
  padding-bottom: 40rpx;
}

.container {
  font-family: PingFang SC;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}

/* ============ Hero ============ */
.hero {
  width: 100%;
  padding: 80rpx 40rpx 60rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  text-align: center;
  border-bottom-left-radius: 40rpx;
  border-bottom-right-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(91, 174, 146, 0.2);
}

.hero-title {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  opacity: 0.92;
  letter-spacing: 1rpx;
}

.hero-tags {
  display: inline-flex;
  gap: 16rpx;
  margin-top: 32rpx;
  flex-wrap: wrap;
  justify-content: center;
}

.hero-tag {
  padding: 8rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.22);
  border: 2rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx;
  font-size: 24rpx;
}

/* ============ 模块入口 ============ */
.modules {
  width: 92%;
  margin-top: 40rpx;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.module-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s;
}

.module-card:active {
  transform: scale(0.97);
  background-color: #FAFCFB;
}

.module-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.module-name {
  margin-top: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A28;
}

.module-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6B7875;
}

/* ============ 底部 ============ */
.footer {
  margin-top: 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #B0BBB8;
  letter-spacing: 1rpx;
}

.footer-line {
  margin: 4rpx 0;
}

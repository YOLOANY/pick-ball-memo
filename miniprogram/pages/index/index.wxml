<!--pages/index/index.wxml-->
<view class="container">

  <!-- 顶部 Hero -->
  <view class="hero">
    <view class="hero-title">🎾 拾球记</view>
    <view class="hero-sub">高校运动资源共享小程序</view>
    <view class="hero-tags">
      <text class="hero-tag">约球</text>
      <text class="hero-tag">场地</text>
      <text class="hero-tag">出物</text>
      <text class="hero-tag">打卡</text>
    </view>
  </view>

  <!-- ① 搜索框 -->
  <view class="search-bar" bindtap="onTapSearch">
    <text class="search-icon">🔍</text>
    <text class="search-placeholder">搜索运动 / 场地 / 出物</text>
  </view>

  <!-- ② 横向滚动公告栏 -->
  <scroll-view class="announce-bar" scroll-x="true" enable-flex="true" show-scrollbar="false">
    <view class="announce-item"
          wx:for="{{announcements}}" wx:key="id"
          data-id="{{item.id}}"
          bindtap="onTapAnnouncement">
      <text class="announce-emoji">{{item.emoji}}</text>
      <text class="announce-text">{{item.text}}</text>
    </view>
  </scroll-view>

  <!-- 待办提醒（保留原功能，置于公告之后） -->
  <view class="upcoming {{upcomingCriticalCount > 0 ? 'upcoming--has-critical' : ''}}">
    <view class="upcoming-head">
      <view class="upcoming-title">
        <text class="upcoming-bell {{upcomingCriticalCount > 0 ? 'upcoming-bell--shake' : ''}}">🔔</text>
        <text>待办提醒</text>
        <text class="upcoming-count" wx:if="{{upcomingUrgentCount > 0}}">{{upcomingUrgentCount}} 项待办</text>
      </view>
      <view class="upcoming-more" bindtap="onGoMy">查看全部 ›</view>
    </view>

    <view wx:if="{{upcomingList.length > 0}}">
      <swiper
        class="upcoming-swiper"
        indicator-dots="{{upcomingList.length > 1}}"
        indicator-color="rgba(176, 187, 184, 0.6)"
        indicator-active-color="#5BAE92"
        circular="{{false}}"
        duration="280"
      >
        <swiper-item
          wx:for="{{upcomingList}}"
          wx:key="_id"
          class="upcoming-swiper-item"
        >
          <view
            class="upcoming-card upcoming-card--{{item.urgentLevel}}"
            bindtap="onTapUpcoming"
            data-id="{{item._id}}"
            data-index="{{index}}"
          >
            <view class="upcoming-sport">
              <text class="upcoming-emoji-small">{{item.sportEmoji}}</text>
            </view>
            <view class="upcoming-info">
              <view class="upcoming-line1">
                <text class="upcoming-sport-name">{{item.sportLabel}}约球</text>
                <text class="upcoming-role upcoming-role--{{item.role}}">{{item.role === 'creator' ? '发起' : '参与'}}</text>
                <text class="upcoming-urgent-tag" wx:if="{{item.urgentLevel === 'critical'}}">⏰ 即将开始</text>
              </view>
              <view class="upcoming-line2">
                <text class="upcoming-icon">🕐</text>
                <text class="upcoming-time">{{item.time}}</text>
                <text class="upcoming-icon">📍</text>
                <text class="upcoming-loc">{{item.location}}</text>
              </view>
              <view class="upcoming-countdown {{item.urgentLevel === 'critical' ? 'upcoming-countdown--critical' : (item.urgentLevel === 'urgent' ? 'upcoming-countdown--urgent' : '')}}">
                {{item.countdownText}}
              </view>
            </view>
            <view class="upcoming-arrow">›</view>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <view class="upcoming-empty" wx:else>
      <view class="upcoming-empty-emoji">🗓️</view>
      <view class="upcoming-empty-title">暂无待办</view>
      <view class="upcoming-empty-sub">发布或加入一个未来的约球，会自动出现在这里</view>
      <view class="upcoming-empty-btn" bindtap="onNav" data-url="/pages/ball/list">去广场看看</view>
    </view>
  </view>

  <!-- ③ 快捷功能区：2列 -->
  <view class="quick-actions">
    <view class="quick-card"
          wx:for="{{quickActions}}" wx:key="id"
          data-url="{{item.url}}"
          bindtap="onNav">
      <view class="quick-emoji">{{item.emoji}}</view>
      <view class="quick-name">{{item.name}}</view>
      <view class="quick-desc">{{item.desc}}</view>
    </view>
  </view>

  <!-- ⑤ 预览模块 1：最新约球 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">🎾 最新约球</view>
      <view class="section-more" bindtap="onNav" data-url="/pages/ball/list">查看全部 ›</view>
    </view>
    <scroll-view class="preview-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="preview-card preview-card--ball"
            wx:for="{{ballPreviews}}" wx:key="_id"
            data-id="{{item._id}}"
            bindtap="onTapBallPreview">
        <view class="preview-emoji">{{item.sportEmoji}}</view>
        <view class="preview-name">{{item.sportLabel}}约球</view>
        <view class="preview-meta">📍 {{item.location}}</view>
        <view class="preview-meta">🕐 {{item.timeText}}</view>
        <view class="preview-foot">
          <text class="preview-tag">{{item.currentCount}}/{{item.needCount}} 人</text>
        </view>
      </view>
      <view class="preview-empty" wx:if="{{ballPreviews.length === 0}}">
        <text>暂无约球</text>
      </view>
    </scroll-view>
  </view>

  <!-- ⑤ 预览模块 2：热门共享出物 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">🎒 热门共享出物</view>
      <view class="section-more" bindtap="onNav" data-url="/pages/equipment/list">查看全部 ›</view>
    </view>
    <scroll-view class="preview-scroll" scroll-x="true" enable-flex="true" show-scrollbar="false">
      <view class="preview-card preview-card--equip"
            wx:for="{{equipPreviews}}" wx:key="_id"
            data-id="{{item._id}}"
            bindtap="onTapEquipPreview">
        <view class="preview-emoji preview-emoji--equip">{{item.categoryEmoji}}</view>
        <view class="preview-name preview-name--equip">
          <text class="tag {{item.tradeTypeClass}}">{{item.tradeTypeLabel}}</text>
          <text class="name-text">{{item.name}}</text>
        </view>
        <view class="preview-price">{{item.priceText}}</view>
        <view class="preview-foot">
          <text class="preview-meta-small">{{item.condition}}</text>
        </view>
      </view>
      <view class="preview-empty" wx:if="{{equipPreviews.length === 0}}">
        <text>暂无出物</text>
      </view>
    </scroll-view>
  </view>

  <!-- 底部占位（避免 FAB 遮挡内容） -->
  <view class="bottom-spacer"></view>

  <!-- ④ 快速发布 FAB -->
  <view class="fab-publish" bindtap="openPublishModal">
    <text class="fab-publish-emoji">＋</text>
    <text class="fab-publish-text">快速发布</text>
  </view>

  <!-- 快速发布弹窗 -->
  <view class="modal-mask" wx:if="{{showPublishModal}}" bindtap="closePublishModal">
    <view class="modal-card" catchtap="">
      <view class="modal-title">📝 选择发布类型</view>
      <view class="modal-options">
        <view class="modal-option" data-type="ball" bindtap="onSelectPublishType">
          <text class="modal-option-emoji">🎾</text>
          <view class="modal-option-info">
            <view class="modal-option-name">发布约球</view>
            <view class="modal-option-desc">约同学一起运动</view>
          </view>
          <text class="modal-option-arrow">›</text>
        </view>
        <view class="modal-option" data-type="equipment" bindtap="onSelectPublishType">
          <text class="modal-option-emoji">🎒</text>
          <view class="modal-option-info">
            <view class="modal-option-name">发布出物租借</view>
            <view class="modal-option-desc">分享闲置出物</view>
          </view>
          <text class="modal-option-arrow">›</text>
        </view>
      </view>
      <view class="modal-cancel" bindtap="closePublishModal">取消</view>
    </view>
  </view>

</view>

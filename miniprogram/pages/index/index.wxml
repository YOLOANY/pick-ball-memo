<!--pages/index/index.wxml-->
<view class="container">

  <!-- 顶部 Hero -->
  <view class="hero">
    <view class="hero-title">🎾 拾球记</view>
    <view class="hero-sub">高校运动资源共享小程序</view>
    <view class="hero-tags">
      <text class="hero-tag">约球</text>
      <text class="hero-tag">场地</text>
      <text class="hero-tag">器材</text>
      <text class="hero-tag">打卡</text>
    </view>
  </view>

  <!-- 我需要赴约 -->
  <view class="upcoming" wx:if="{{upcomingList.length > 0}}">
    <view class="upcoming-head">
      <view class="upcoming-title">
        <text class="upcoming-emoji">📅</text>
        <text>我需要赴约</text>
        <text class="upcoming-count">{{upcomingList.length}}</text>
      </view>
      <view class="upcoming-more" bindtap="onGoMy">查看全部 ›</view>
    </view>
    <view
      class="upcoming-card"
      wx:for="{{upcomingList}}"
      wx:key="_id"
      bindtap="onTapUpcoming"
      data-id="{{item._id}}"
      data-index="{{index}}"
    >
      <view class="upcoming-sport">
        <text class="upcoming-emoji-small">{{item.sportEmoji}}</text>
      </view>
      <view class="upcoming-info">
        <view class="upcoming-line1">
          <text class="upcoming-sport-name">{{item.sportLabel}}约球</text>
          <text class="upcoming-role upcoming-role--{{item.role}}">{{item.role === 'creator' ? '发起' : '参与'}}</text>
        </view>
        <view class="upcoming-line2">
          <text class="upcoming-icon">🕐</text>
          <text class="upcoming-time">{{item.time}}</text>
          <text class="upcoming-icon">📍</text>
          <text class="upcoming-loc">{{item.location}}</text>
        </view>
        <view class="upcoming-countdown {{item.urgent ? 'upcoming-countdown--urgent' : ''}}">
          {{item.countdownText}}
        </view>
      </view>
      <view class="upcoming-arrow">›</view>
    </view>
  </view>

  <!-- 4 个模块入口 -->
  <view class="modules">
    <view class="module-card" bindtap="onNav" data-url="/pages/ball/list">
      <view class="module-emoji">🎾</view>
      <view class="module-name">约球广场</view>
      <view class="module-desc">找球友一起运动</view>
    </view>
    <view class="module-card" bindtap="onNav" data-url="/pages/venue/list">
      <view class="module-emoji">🏟️</view>
      <view class="module-name">场地预约</view>
      <view class="module-desc">网球场/羽毛球场</view>
    </view>
    <view class="module-card" bindtap="onNav" data-url="/pages/equipment/list">
      <view class="module-emoji">🎒</view>
      <view class="module-name">器材共享</view>
      <view class="module-desc">闲置器材租借</view>
    </view>
    <view class="module-card" bindtap="onNav" data-url="/pages/moment/list">
      <view class="module-emoji">🏃</view>
      <view class="module-name">运动打卡</view>
      <view class="module-desc">分享运动时刻</view>
    </view>
  </view>

  <!-- 底部提示条 -->
  <view class="footer">
    <view class="footer-line">面向大学生的运动资源共享平台</view>
    <view class="footer-line">微信云开发 · 免部署 · 易演示</view>
  </view>

</view>

/* pages/ball/detail.wxss */
page {
  background-color: #F4F8F6;
}

.page {
  min-height: 100vh;
  padding-bottom: 200rpx;
}

.loading {
  text-align: center;
  padding: 200rpx 0;
  color: #B0BBB8;
  font-size: 28rpx;
}

/* ============ 顶部 Hero ============ */
.hero {
  margin: 24rpx 32rpx 0;
  padding: 36rpx 32rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18);
}

.hero-sport {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.hero-emoji {
  font-size: 80rpx;
  line-height: 1;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.92;
}

.hero-progress {
  text-align: right;
}

.hero-progress-num {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.1;
}

.hero-progress-label {
  font-size: 22rpx;
  opacity: 0.85;
  margin-top: 4rpx;
}

.hero-countdown {
  margin-top: 10rpx;
  display: inline-block;
  padding: 4rpx 14rpx;
  background-color: rgba(255, 255, 255, 0.22);
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 20rpx;
  letter-spacing: 1rpx;
}

.hero-progress-bar {
  margin-top: 12rpx;
  width: 140rpx;
  height: 10rpx;
  background-color: rgba(255, 255, 255, 0.3);
  border-radius: 6rpx;
  overflow: hidden;
}

.hero-progress-bar-inner {
  height: 100%;
  background-color: #ffffff;
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* ============ 通用卡片 ============ */
.card {
  margin: 24rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1F2A28;
  margin-bottom: 20rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #5BAE92;
  line-height: 1;
}

/* ============ 详情行 ============ */
.row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F1F5F3;
}

.row:last-child {
  border-bottom: none;
}

.row--column {
  flex-direction: column;
  align-items: flex-start;
}

.row-label {
  width: 160rpx;
  font-size: 26rpx;
  color: #6B7875;
  flex-shrink: 0;
}

.row-value {
  flex: 1;
  font-size: 28rpx;
  color: #1F2A28;
  word-break: break-all;
}

.row-value--multi {
  margin-top: 12rpx;
  line-height: 1.6;
  width: 100%;
}

.row-value--contact {
  color: #5BAE92;
  font-weight: 500;
}

.row-value--remind-on {
  color: #3D8C72;
  font-weight: 500;
}

/* ============ 发起人 ============ */
.creator {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.creator-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #EEF2F0;
}

.creator-info {
  flex: 1;
}

.creator-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2A28;
}

.creator-time {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #B0BBB8;
}

.creator-tag {
  padding: 4rpx 16rpx;
  background-color: #E8F4EE;
  color: #3D8C72;
  font-size: 22rpx;
  border-radius: 24rpx;
  font-weight: 500;
}

/* ============ 成员列表 ============ */
.members {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.member {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #EEF2F0;
}

.member-name {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #4A5856;
  text-align: center;
  max-width: 120rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ============ 底部操作栏 ============ */
.bottom-spacer {
  height: 160rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  border-radius: 44rpx;
  font-weight: 500;
  letter-spacing: 2rpx;
  margin: 0;
}

.btn::after {
  border: none;
}

.btn--primary {
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(91, 174, 146, 0.3);
}

.btn--secondary {
  background-color: #ffffff;
  color: #5BAE92;
  border: 2rpx solid #5BAE92;
}

.btn--ghost {
  background-color: #F4F8F6;
  color: #3D8C72;
  border: 2rpx solid #C9DDD5;
}

.btn--danger {
  background-color: #ffffff;
  color: #E15A5A;
  border: 2rpx solid #E15A5A;
}

.btn--disabled {
  background-color: #F1F3F2;
  color: #B0BBB8;
}

.btn--completed {
  background: linear-gradient(135deg, #5B92AE 0%, #7BAFCE 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(91, 146, 174, 0.3);
}

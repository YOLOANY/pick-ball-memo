<!--pages/ball/my.wxml-->
<!--
  我的约球
  两个 tab：
    - 我发起的：调 ballAdd.myPosts（含已关闭/已过期，广场看不到的也能在这里看到）
    - 我加入的：调 ballAdd.myJoined（我申请入队的帖子）
  卡片样式复用 list.wxml 的完整卡片（含截止时间/进度条）
-->
<view class="page">

  <!-- 提醒中心入口（带未读 badge） -->
  <view class="remind-entry" bindtap="onGoNotifications">
    <view class="remind-entry-left">
      <view class="remind-entry-emoji">🔔</view>
      <view class="remind-entry-info">
        <view class="remind-entry-title">提醒中心</view>
        <view class="remind-entry-sub">查看约球「提前 2 小时」通知</view>
      </view>
    </view>
    <view class="remind-entry-right">
      <text wx:if="{{unreadCount > 0}}" class="remind-entry-badge">{{unreadCount}}</text>
      <text class="remind-entry-arrow">›</text>
    </view>
  </view>

  <!-- 顶部 tab 切换：发起 / 加入 / 历史 -->
  <view class="tabs">
    <view class="tab {{tab === 'created' ? 'tab--active' : ''}}" data-tab="created" bindtap="onSwitchTab">发起</view>
    <view class="tab {{tab === 'joined' ? 'tab--active' : ''}}" data-tab="joined" bindtap="onSwitchTab">加入</view>
    <view class="tab {{tab === 'history' ? 'tab--active' : ''}}" data-tab="history" bindtap="onSwitchTab">历史</view>
  </view>

  <!-- 列表区域 -->
  <view class="list" wx:if="{{list.length > 0}}">
    <view
      class="card {{tab === 'history' ? 'card--history' : ''}}"
      wx:for="{{list}}"
      wx:key="_id"
      bindtap="onTapItem"
      data-id="{{item._id}}"
      data-index="{{index}}"
    >
      <view class="card-head">
        <view class="card-head-left">
          <view class="card-emoji">{{item.sportEmoji}}</view>
          <view class="card-sport">
            {{item.sportLabel}}
            <text class="card-history-tag" wx:if="{{tab === 'history'}}">已结束</text>
          </view>
        </view>
        <view class="card-head-right">
          <text
            wx:if="{{item.hasReminder}}"
            class="bell-badge"
            catchtap="onToggleReminder"
            data-id="{{item._id}}"
            data-index="{{index}}"
          >🔔</text>
          <view class="card-status card-status--{{item.effectiveStatus}}">
            {{item.statusLabel}}
          </view>
        </view>
      </view>

      <view class="card-info">
        <view class="info-row">
          <text class="info-icon">🕐</text>
          <text class="info-text">{{item.time}}</text>
        </view>
        <view class="info-row">
          <text class="info-icon">📍</text>
          <text class="info-text">{{item.location}}</text>
        </view>
        <view wx:if="{{item.deadlineText}}" class="info-row info-row--deadline">
          <text class="info-icon">⏰</text>
          <text class="info-text">截止 {{item.deadlineText}} <text class="info-countdown" wx:if="{{item.countdownText}}">{{item.countdownText}}</text></text>
        </view>
        <view class="info-row">
          <text class="info-icon">👥</text>
          <text class="info-text">已招募 {{item.currentCount}}/{{item.needCount}} 人</text>
          <view class="progress">
            <view class="progress-bar" style="width: {{item.progress}}%;"></view>
          </view>
        </view>
      </view>

      <view class="card-foot">
        <view class="creator">
          <image class="creator-avatar" src="{{item.avatarUrl || defaultAvatar}}"></image>
          <text class="creator-name">{{tab === 'created' ? item.nickName : '发起人 ' + item.nickName}}</text>
        </view>
        <text class="timeago">{{item.timeAgo}}</text>
      </view>

      <!-- 关键：仅「我发起的」tab 显示一行操作：未招到人时可一键删除 -->
      <view wx:if="{{tab === 'created'}}" class="card-actions" catchtap="onTapCardActions">
        <view
          class="card-action card-action--delete {{(item.currentCount || 0) <= 1 ? '' : 'card-action--disabled'}}"
          catchtap="onDeleteMyPost"
          data-id="{{item._id}}"
          data-index="{{index}}"
        >🗑 删除帖子</view>
      </view>
    </view>

    <view class="list-end">— 没有更多了 —</view>
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:else>
    <view class="empty-emoji">{{tab === 'created' ? '📝' : (tab === 'history' ? '📜' : '🤝')}}</view>
    <view class="empty-title">{{emptyText}}</view>
    <view class="empty-sub">{{emptySub}}</view>
    <view class="empty-btn" bindtap="onGoList" wx:if="{{tab !== 'history'}}">去广场看看</view>
    <!-- 关键诊断：把当前 openid 前缀显示在空态下方 -->
    <view class="empty-debug" wx:if="{{debugOpenid}}">
      <view class="empty-debug-hint">{{debugHint}}</view>
      <view class="empty-debug-openid">openid: {{debugOpenid}}</view>
      <view class="empty-debug-tip">如果之前发布过、现在看不到，对比控制台 [ball my] 日志里的 openid 前缀是否一致</view>
    </view>
  </view>

</view>

<!--pages/ball/publish.wxml-->
<!--
  约球帖子发布页面
  功能：填写运动项目 / 时间 / 地点 / 人数 / 备注等信息并提交
  数据：表单数据全部存放在 formData 中，提交时通过 wx.cloud.callFunction 上传给 ballAdd 云函数
-->
<view class="page">

  <!-- 顶部横幅：渐变绿，凸显校园清新风 -->
  <view class="hero">
    <view class="hero-title">{{editingMode ? '编辑约球 ✏️' : '发起一次约球 🎾'}}</view>
    <view class="hero-sub">{{editingMode ? '还没人入队，可以随时修改内容' : '找几个球友，一起挥洒汗水'}}</view>
  </view>

  <!-- 运动项目选择：横向滚动卡片 -->
  <view class="section">
    <view class="section-title">运动项目</view>
    <scroll-view class="sport-scroll" scroll-x="true" enhanced="true" show-scrollbar="{{false}}">
      <view class="sport-list">
        <view
          wx:for="{{sportList}}"
          wx:key="value"
          class="sport-item {{formData.sport === item.value ? 'sport-item--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectSport"
        >
          <view class="sport-emoji">{{item.emoji}}</view>
          <view class="sport-name">{{item.label}}</view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 表单卡片：时间 / 地点 / 人数 / 备注 等 -->
  <view class="card">

    <!-- 时间选择：日期 + 时间（统一用原生 picker 模板，与微信原生体验一致） -->
    <view class="field field--column time-field">
      <view class="field-label">日期 · 时间</view>

      <!-- 日期行：点格调起自定义 picker 弹层（picker-view，大字体） -->
      <view class="time-date-row">
        <view class="time-date-cell" bindtap="onOpenDatePicker">
          <view class="time-date-icon">📅</view>
          <view class="time-date-text">
            <view class="time-date-label">日期</view>
            <view class="time-date-value">{{timeDate || '请选择日期'}}</view>
          </view>
          <view class="arrow">›</view>
        </view>
      </view>

      <!-- 时间行：点格调起自定义 picker 弹层（picker-view，大字体） -->
      <view class="time-date-row">
        <view class="time-date-cell" bindtap="onOpenTimePicker">
          <view class="time-date-icon">🕐</view>
          <view class="time-date-text">
            <view class="time-date-label">时间</view>
            <view class="time-date-value">{{timeTime || '请选择时间'}}</view>
          </view>
          <view class="arrow">›</view>
        </view>
      </view>

      <view wx:if="{{timeError}}" class="time-error">⚠ {{timeError}}</view>
      <view class="time-hint">💡 默认时间为「现在 + 3 小时」；点日期 / 时间格选</view>
    </view>

    <view class="divider"></view>

    <!-- 地点输入 -->
    <view class="field field--input">
      <view class="field-label">地点</view>
      <input
        class="field-input"
        placeholder="如：北校区网球场 3 号场"
        placeholder-class="placeholder"
        value="{{formData.location}}"
        bindinput="onInputChange"
        bindblur="onInputBlur"
        data-field="location"
        maxlength="50"
        confirm-type="done"
      />
    </view>

    <view class="divider"></view>

    <!-- 招募截止时间（可选；不填则默认为现在+3小时，与约球时间默认一致） -->
    <!-- 关键：弹层里 date + time 两个 picker 同屏，调完点确认一次性写入 -->
    <view class="field">
      <view class="field-label">招募截止时间</view>
      <view class="field-value" bindtap="onOpenDeadlinePicker">
        <text wx:if="{{formData.recruitDeadlineText}}">{{formData.recruitDeadlineText}}</text>
        <text wx:else class="placeholder">不填则默认为现在+3小时</text>
        <text class="arrow">›</text>
      </view>
      <view wx:if="{{formData.recruitDeadline}}" class="field-clear" catchtap="onClearDeadline">清除</view>
    </view>

    <view class="divider"></view>

    <!-- 提前 2 小时提醒（发布者自己；勾选后会在发布成功时弹订阅授权） -->
    <view class="field field--column">
      <view class="field-label">提前 2 小时提醒</view>
      <view class="remind-row">
        <switch checked="{{formData.remindEnabled}}" bindchange="onToggleRemind" color="#5BAE92"/>
        <text class="remind-hint">勾选后，约球开始前 2 小时会通过「服务通知」提醒我</text>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 人数步进器：- 和 + 按钮控制 count -->
    <view class="field">
      <view class="field-label">需要人数</view>
      <view class="stepper">
        <view class="stepper-btn {{formData.needCount <= 1 ? 'stepper-btn--disabled' : ''}}" bindtap="onCountMinus">－</view>
        <view class="stepper-value">{{formData.needCount}}</view>
        <view class="stepper-btn {{formData.needCount >= 20 ? 'stepper-btn--disabled' : ''}}" bindtap="onCountPlus">＋</view>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 招募范围：单选 -->
    <view class="field field--column">
      <view class="field-label">招募范围</view>
      <view class="radio-group">
        <view
          wx:for="{{scopeList}}"
          wx:key="value"
          class="radio-item {{formData.scope === item.value ? 'radio-item--active' : ''}}"
          data-value="{{item.value}}"
          bindtap="onSelectScope"
        >{{item.label}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 联系方式 -->
    <view class="field field--input">
      <view class="field-label">联系方式</view>
      <input
        class="field-input"
        placeholder="微信号 / QQ（选填）"
        placeholder-class="placeholder"
        value="{{formData.contact}}"
        bindinput="onInputChange"
        data-field="contact"
        maxlength="30"
      />
    </view>

    <view class="divider"></view>

    <!-- 备注说明 -->
    <view class="field field--column">
      <view class="field-label">备注说明</view>
      <textarea
        class="field-textarea"
        placeholder="简单描述一下：水平要求、装备要求、是否 AA 等"
        placeholder-class="placeholder"
        value="{{formData.remark}}"
        bindinput="onInputChange"
        data-field="remark"
        maxlength="200"
        auto-height
      />
      <view class="field-counter">{{formData.remark.length}}/200</view>
    </view>
  </view>

  <!-- 友情提示 -->
  <view class="tip">📌 请文明约球，按时赴约，友好互动</view>

  <!-- 底部占位：避免内容被悬浮按钮遮挡 -->
  <view class="bottom-spacer"></view>

  <!-- 底部固定提交按钮 -->
  <view class="bottom-bar">
    <button class="btn-submit" bindtap="onSubmit" loading="{{submitting}}"><text class="btn-submit-text">{{editingMode ? '保存修改' : '发布约球'}}</text></button>
  </view>

  <!-- 招募截止时间选择弹层 -->
  <!-- 关键：date + time 两个 picker 同屏；start 限定为今天；end 限定为 30 天后 -->
  <!-- 关键修复：遮罩和弹层改为兄弟节点，避免外层 catchtap 吞掉 picker 子 view 的 tap，导致 bindchange 不触发 / 显示不更新 -->
  <block wx:if="{{deadlinePickerVisible}}">
    <view class="deadline-mask" bindtap="onCloseDeadlinePicker"></view>
    <view class="deadline-popup">
      <view class="deadline-popup-title">选择招募截止时间</view>
      <view class="deadline-popup-sub">不填则默认为现在+3小时</view>

      <view class="deadline-picker-row">
        <view class="deadline-picker-col">
          <view class="deadline-picker-label">日期</view>
          <picker mode="date" value="{{deadlineDate}}" start="{{deadlineDateStart}}" end="{{deadlineDateEnd}}" bindchange="onDeadlineDateChange">
            <view class="deadline-picker-value">{{deadlineDate || '请选择'}}</view>
          </picker>
        </view>
        <view class="deadline-picker-col">
          <view class="deadline-picker-label">时间</view>
          <picker mode="time" value="{{deadlineTime}}" bindchange="onDeadlineTimeChange">
            <view class="deadline-picker-value">{{deadlineTime || '请选择'}}</view>
          </picker>
        </view>
      </view>

      <view class="deadline-popup-actions">
        <view class="deadline-popup-btn deadline-popup-btn--cancel" bindtap="onCloseDeadlinePicker">取消</view>
        <view class="deadline-popup-btn deadline-popup-btn--confirm" bindtap="onConfirmDeadline">确认</view>
      </view>
    </view>
  </block>

  <!-- ============ 自定义日期选择弹层（单列 scroll-view，每行渲染完整日期 "2026年 9月 6日"） ============ -->
  <!-- 关键：重构后三列合并成一列，"2026年 9月 6日" 整行渲染，三段文字天然在同一垂直线 -->
  <block wx:if="{{datePickerVisible}}">
    <view class="picker-mask" bindtap="onCloseDatePicker"></view>
    <view class="picker-popup">
      <view class="picker-header">
        <view class="picker-btn" bindtap="onCloseDatePicker">取消</view>
        <view class="picker-title">选择日期</view>
        <view class="picker-btn picker-btn--primary" bindtap="onConfirmDatePicker">确定</view>
      </view>
      <view class="picker-wheel-container">
        <scroll-view
          class="picker-wheel-column"
          scroll-y
          enhanced
          bounces="{{false}}"
          show-scrollbar="{{false}}"
          scroll-top="{{dateScrollTop}}"
          scroll-with-animation
          bindscroll="onPickerColumnScroll"
          data-picker="date"
          data-column="single"
        >
          <view class="picker-wheel-spacer"></view>
          <view wx:for="{{dateList}}" wx:key="*this" class="picker-wheel-item picker-wheel-date-item">
            <text class="picker-date-year">{{item.year}}年</text>
            <text class="picker-date-sep">·</text>
            <text class="picker-date-month">{{item.month}}月</text>
            <text class="picker-date-sep">·</text>
            <text class="picker-date-day">{{item.day}}日</text>
          </view>
          <view class="picker-wheel-spacer"></view>
        </scroll-view>
        <view class="picker-wheel-indicator"></view>
      </view>
    </view>
  </block>

  <!-- ============ 自定义时间选择弹层（时 / 分 两列独立 scroll-view，PC 鼠标滚轮可用） ============ -->
  <block wx:if="{{timePickerCustomVisible}}">
    <view class="picker-mask" bindtap="onCloseTimePicker"></view>
    <view class="picker-popup">
      <view class="picker-header">
        <view class="picker-btn" bindtap="onCloseTimePicker">取消</view>
        <view class="picker-title">选择时间</view>
        <view class="picker-btn picker-btn--primary" bindtap="onConfirmTimePicker">确定</view>
      </view>
      <view class="picker-wheel-container">
        <scroll-view
          class="picker-wheel-column"
          scroll-y
          enhanced
          bounces="{{false}}"
          show-scrollbar="{{false}}"
          scroll-top="{{timeHourScrollTop}}"
          scroll-with-animation
          bindscroll="onPickerColumnScroll"
          data-picker="time"
          data-column="hour"
        >
          <view class="picker-wheel-spacer"></view>
          <view wx:for="{{hourList}}" wx:key="*this" class="picker-wheel-item" style="position: relative; left: 56.25rpx; top: 5.875rpx">{{item}}</view>
          <view class="picker-wheel-spacer"></view>
        </scroll-view>
        <view class="picker-wheel-sep">：</view>
        <scroll-view
          class="picker-wheel-column"
          scroll-y
          enhanced
          bounces="{{false}}"
          show-scrollbar="{{false}}"
          scroll-top="{{timeMinuteScrollTop}}"
          scroll-with-animation
          bindscroll="onPickerColumnScroll"
          data-picker="time"
          data-column="minute"
        >
          <view class="picker-wheel-spacer"></view>
          <view wx:for="{{minuteList}}" wx:key="*this" class="picker-wheel-item" style="position: relative; left: -84.375rpx; top: 23.75rpx">{{item}}</view>
          <view class="picker-wheel-spacer"></view>
        </scroll-view>
        <view class="picker-wheel-indicator"></view>
      </view>
    </view>
  </block>

</view>

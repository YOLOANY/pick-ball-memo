/* pages/ball/publish.wxss */
/* 主题色：清新的草本绿，契合校园运动场景，柔和不刺眼 */
page {
  background-color: #F4F8F6;
}

.page {
  padding-bottom: 40rpx;
}

/* ============ 顶部 Hero 横幅 ============ */
.hero {
  padding: 50rpx 40rpx 60rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18);
}

.hero-title {
  font-size: 44rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 26rpx;
  opacity: 0.92;
}

/* ============ 通用分区 ============ */
.section {
  padding: 36rpx 32rpx 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2A28;
  margin-bottom: 24rpx;
  padding-left: 12rpx;
  border-left: 8rpx solid #5BAE92;
  line-height: 1;
}

/* ============ 运动项目横向卡片 ============ */
.sport-scroll {
  white-space: nowrap;
}

.sport-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 4rpx 0;
}

.sport-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 150rpx;
  background-color: #ffffff;
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s;
}

.sport-item--active {
  background-color: #E8F4EE;
  border-color: #5BAE92;
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 20rpx rgba(91, 174, 146, 0.18);
}

.sport-emoji {
  font-size: 52rpx;
  line-height: 1;
}

.sport-name {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #1F2A28;
}

.sport-item--active .sport-name {
  color: #3D8C72;
  font-weight: 600;
}

/* ============ 表单卡片 ============ */
.card {
  margin: 36rpx 32rpx 0;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110rpx;
  padding: 24rpx 0;
}

.field--column {
  flex-direction: column;
  align-items: stretch;
}

.field--input {
  /* input 行不需要右侧固定值 */
}

.field-label {
  font-size: 30rpx;
  color: #1F2A28;
  font-weight: 500;
  flex-shrink: 0;
  width: 160rpx;
}

.field--column .field-label {
  width: 100%;
  margin-bottom: 16rpx;
}

.field-value {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 30rpx;
  color: #1F2A28;
}

.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #1F2A28;
  text-align: right;
}

.placeholder {
  color: #B0BBB8;
  font-size: 28rpx;
}

.arrow {
  margin-left: 8rpx;
  color: #B0BBB8;
  font-size: 36rpx;
  line-height: 1;
  font-weight: 300;
}

.field-clear {
  margin-left: 16rpx;
  padding: 4rpx 16rpx;
  background-color: #FFF1E5;
  color: #C97B3A;
  font-size: 22rpx;
  border-radius: 20rpx;
  align-self: center;
  flex-shrink: 0;
}

/* 分隔线 */
.divider {
  height: 2rpx;
  background-color: #EEF2F0;
  margin: 0 -32rpx;
}

/* ============ 步进器（人数） ============ */
.stepper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stepper-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 50rpx;
  text-align: center;
  font-size: 36rpx;
  color: #5BAE92;
  background-color: #E8F4EE;
  border-radius: 50%;
  font-weight: 500;
}

.stepper-btn--disabled {
  color: #B0BBB8;
  background-color: #F1F5F3;
}

.stepper-value {
  min-width: 60rpx;
  text-align: center;
  font-size: 32rpx;
  color: #1F2A28;
  font-weight: 500;
}

/* ============ 单选组（招募范围） ============ */
.radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.radio-item {
  padding: 14rpx 28rpx;
  font-size: 26rpx;
  color: #6B7875;
  background-color: #F4F8F6;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
}

.radio-item--active {
  color: #3D8C72;
  background-color: #E8F4EE;
  border-color: #5BAE92;
  font-weight: 500;
}

/* ============ 提醒开关（提前 2 小时） ============ */
.remind-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 8rpx 0;
}

.remind-hint {
  flex: 1;
  font-size: 24rpx;
  color: #6B7875;
  line-height: 1.5;
}

/* ============ 文本域 + 计数器 ============ */
.field-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: #1F2A28;
  line-height: 1.6;
  box-sizing: border-box;
  padding: 8rpx 0;
}

.field-counter {
  text-align: right;
  font-size: 22rpx;
  color: #B0BBB8;
  margin-top: 8rpx;
}

/* ============ 提示条 ============ */
.tip {
  margin: 32rpx 32rpx 0;
  padding: 20rpx 24rpx;
  font-size: 24rpx;
  color: #6B7875;
  background-color: #FFF7E6;
  border-left: 6rpx solid #F5B947;
  border-radius: 12rpx;
  line-height: 1.5;
}

/* ============ 底部固定提交按钮 ============ */
.bottom-spacer {
  height: 160rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.btn-submit {
  height: 92rpx;
  line-height: 92rpx;
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 46rpx;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 20rpx rgba(91, 174, 146, 0.3);
}

.btn-submit[disabled] {
  background: #B0BBB8;
  color: #ffffff;
}

/* ============ 时间选择：日期 + 时间都用自定义 scroll-view 滚轮弹层（大字体 + 鼠标滚轮） ============ */

/* 日期 / 时间行：点格调起自定义 picker 弹层（与表单 row 风格统一） */
.time-date-row {
  margin-bottom: 16rpx;
}

.time-date-row:last-of-type {
  margin-bottom: 0;
}

.time-date-cell {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 28rpx;
  background-color: #F4F8F6;
  border-radius: 16rpx;
  border: 2rpx solid #E8EEEB;
}

.time-date-cell:active {
  background-color: #E8F4EE;
  border-color: #5BAE92;
}

.time-date-icon {
  font-size: 36rpx;
  line-height: 1;
  flex-shrink: 0;
}

.time-date-text {
  flex: 1;
  min-width: 0;
}

.time-date-label {
  font-size: 22rpx;
  color: #8B9694;
  line-height: 1.2;
}

.time-date-value {
  margin-top: 6rpx;
  font-size: 30rpx;
  color: #1F2A28;
  font-weight: 500;
  font-family: monospace;
  letter-spacing: 1rpx;
  line-height: 1.2;
}

.time-error {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #E15A5A;
  padding-left: 8rpx;
  line-height: 1.4;
}

.time-hint {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #8B9694;
  padding-left: 8rpx;
  line-height: 1.4;
}

/* ============ 招募截止时间选择弹层 ============ */
/* 关键修复：遮罩和弹层改为兄弟节点 + 各自 fixed 定位，避免外层 catchtap 拦截 picker */
.deadline-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.deadline-popup {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  width: calc(100% - 120rpx);
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx 32rpx;
  box-shadow: 0 12rpx 32rpx rgba(0, 0, 0, 0.2);
}

.deadline-popup-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F2A28;
  text-align: center;
}

.deadline-popup-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8B9694;
  text-align: center;
}

.deadline-picker-row {
  display: flex;
  gap: 20rpx;
  margin: 36rpx 0 24rpx;
}

.deadline-picker-col {
  flex: 1;
  background-color: #F4F8F6;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.deadline-picker-label {
  font-size: 24rpx;
  color: #8B9694;
  margin-bottom: 10rpx;
}

.deadline-picker-value {
  font-size: 30rpx;
  color: #1F2A28;
  font-weight: 500;
  padding: 8rpx 0;
}

.deadline-popup-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.deadline-popup-btn {
  flex: 1;
  height: 84rpx;
  line-height: 84rpx;
  text-align: center;
  font-size: 30rpx;
  border-radius: 42rpx;
  font-weight: 500;
}

.deadline-popup-btn--cancel {
  background-color: #F4F8F6;
  color: #6B7875;
  border: 2rpx solid #E0EAE6;
}

.deadline-popup-btn--confirm {
  background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%);
  color: #ffffff;
  box-shadow: 0 6rpx 16rpx rgba(91, 174, 146, 0.3);
}

/* ============ 自定义 picker-view 弹层（大字体 40rpx） ============ */
/* 关键：原生 picker 弹层是系统控件、字体不可调；改用 picker-view 自定义列 */

.picker-mask {
  position: fixed;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
}

.picker-popup {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background-color: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.12);
  overflow: hidden;
}

.picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 2rpx solid #EEF2F0;
}

.picker-btn {
  font-size: 30rpx;
  color: #6B7875;
  padding: 8rpx 16rpx;
  min-width: 100rpx;
}

.picker-btn--primary {
  color: #5BAE92;
  font-weight: 600;
  text-align: right;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2A28;
}

.picker-view {
  width: 100%;
  /* height 由 inline style 控制（450rpx），给 indicator 90rpx 留出上下 padding 视觉 */
}

/* ============ 自定义 picker 滚轮：scroll-view 列（PC 鼠标滚轮可用） ============ */

.picker-wheel-container {
  position: relative;
  height: 450rpx;
  display: flex;
  background-color: #ffffff;
  overflow: hidden;
}

.picker-wheel-column {
  /* 三列等宽平分容器：flex: 1 1 0%，从 0 宽度等比增长，避免内容撑开列宽 */
  flex: 1;
  height: 450rpx;
  /* 关键：清除 scroll-view 内部可能的多余 padding/margin */
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.picker-wheel-spacer {
  /* 关键：(容器高 - item 高) / 2 = (450 - 90) / 2 = 180rpx；让首末项都能滚到中心 */
  height: 180rpx;
  padding: 0;
  margin: 0;
  display: block;
}

.picker-wheel-item {
  /* 关键修复：每一列 item 强制水平居中
   * 问题：scroll-view 内部内容渲染时，item 没有显式 width: 100% 时，
   *       文本可能被收缩到内容宽度，"9月" 这种短文本就出现向左偏的现象
   * 方案：width: 100% 让 item 撑满整列 + text-align: center 让文本在 item 内水平居中 */
  display: block;
  width: 100%;
  height: 90rpx;
  line-height: 90rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 400;
  color: #1F2A28;
  /* 关键：清除所有可能让文字偏左的内边距/外边距/缩进 */
  padding: 0;
  margin: 0;
  text-indent: 0;
  box-sizing: border-box;
  white-space: nowrap;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", "Helvetica Neue", Arial, sans-serif;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  text-rendering: optimizeLegibility;
}

/* 时间选择器：小时列整体内容偏上（与分钟列基线错位）
 * 关键：用属性选择器精准锁定小时列（scroll-view 上的 data-column="hour"），不影响分钟列、日期三列
 * 方案：给小时列 item 加 padding-top，让文字在 90rpx 盒子内下移，与分钟列基线对齐
 * box-sizing: border-box 已在 .picker-wheel-item 设置，padding-top 算在 90rpx 高度内，item 行高不变 */
.picker-wheel-column[data-column="hour"] .picker-wheel-item {
  padding-top: 4rpx;
}

/* 日期选择器：月份列"9月"文字跑到容器左侧的修复
 * 根因：WXML 月份列 item 上有内联 style="display: flex..."，
 *       flex 容器下 text-align: center 不会水平居中（flex 用 justify-content），
 *       所以 "9月" 直接贴到容器左边缘。
 * 方案：
 *   1. display: block !important 覆盖内联 display: flex，让 text-align 重新生效
 *   2. 强制 text-align: center、padding-left/right: 0、box-sizing: border-box
 *   3. 用属性选择器 [data-column="month"] 精准锁定月份列，年列、日列不受影响
 * 年列保持原样不动（不写 [data-column="year"] 规则，年列完全继承 .picker-wheel-item 公共样式） */
.picker-wheel-column[data-column="month"] .picker-wheel-item {
  display: block !important;
  text-align: center;
  padding-left: 0 !important;
  padding-right: 0 !important;
  box-sizing: border-box;
}

/* 日期选择器：日列与月份列同步，确保"6日"也严格水平居中（与年列、月列三列基线一致） */
.picker-wheel-column[data-column="day"] .picker-wheel-item {
  text-align: center;
}

/* 日期选择器：三列文字水平对齐
 * 当前状态：月、日列文字在各自列内居中（text-align: center）
 *   - 年列文字 x=125（居中在年列 0-250）
 *   - 月列文字 x=375（居中在月列 250-500）
 *   - 日列文字 x=625（居中在日列 500-750）
 * 三段距离近似相等 = 250rpx
 * 年列不写任何规则，完全保持原样。 */
.picker-wheel-column[data-column="month"] .picker-wheel-item {
  text-align: center !important;
  padding-left: 0;
}

.picker-wheel-column[data-column="day"] .picker-wheel-item {
  text-align: center !important;
  padding-left: 0;
}

.picker-wheel-indicator {
  /* 关键：box-sizing: border-box，否则 2rpx 边框会把视觉中心下推 2rpx，数字看起来"往上偏" */
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 90rpx;
  margin-top: -45rpx;
  box-sizing: border-box;
  border-top: 2rpx solid #5BAE92;
  border-bottom: 2rpx solid #5BAE92;
  background-color: rgba(91, 174, 146, 0.08);
  pointer-events: none;
  z-index: 1;
}

/* 日期选择器：单列 item 内的"2026年·9月·6日"布局
 * 关键：flex + justify-content: center 让三段文字水平居中
 * · 分隔符颜色淡一点（#B0BBB8）做视觉分组 */
.picker-wheel-date-item {
  display: flex !important;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  white-space: nowrap;
  /* 整行视觉下移 33.75rpx（原 45rpx - 上移 1/8 行 11.25rpx），不改变布局位置，snap 逻辑不受影响 */
  transform: translateY(33.75rpx);
}

.picker-date-sep {
  color: #B0BBB8;
  font-size: 28rpx;
  font-weight: 300;
}

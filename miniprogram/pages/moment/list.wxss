/* pages/moment/list.wxss */
page { background-color: #F4F8F6; }
.page { min-height: 100vh; padding-bottom: 200rpx; }

.banner { margin: 24rpx 32rpx 12rpx; padding: 36rpx 32rpx; background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; border-radius: 24rpx; box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18); }
.banner-title { font-size: 38rpx; font-weight: 600; letter-spacing: 2rpx; }
.banner-sub { margin-top: 8rpx; font-size: 24rpx; opacity: 0.92; }

.list { padding: 24rpx 32rpx; }
.card { background-color: #ffffff; border-radius: 20rpx; padding: 24rpx 28rpx; margin-bottom: 24rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04); }

.card-head { display: flex; align-items: center; gap: 16rpx; }
.avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background-color: #EEF2F0; }
.card-info { flex: 1; min-width: 0; }
.nick { font-size: 30rpx; font-weight: 600; color: #1F2A28; }
.time { margin-top: 4rpx; font-size: 22rpx; color: #B0BBB8; }
.mood { font-size: 48rpx; }

.content { margin-top: 20rpx; font-size: 28rpx; color: #1F2A28; line-height: 1.6; }

.images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12rpx; margin-top: 20rpx; }
.grid-img { width: 100%; height: 200rpx; border-radius: 12rpx; background-color: #F4F8F6; }

.card-foot { margin-top: 20rpx; font-size: 24rpx; color: #6B7875; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 160rpx 0; }
.empty-emoji { font-size: 120rpx; opacity: 0.6; }
.empty-title { margin-top: 32rpx; font-size: 32rpx; color: #4A5856; font-weight: 500; }
.empty-sub { margin-top: 12rpx; font-size: 26rpx; color: #B0BBB8; }

.fab { position: fixed; right: 40rpx; bottom: 60rpx; width: 140rpx; height: 140rpx; border-radius: 50%; background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; display: flex; align-items: center; justify-content: center; box-shadow: 0 12rpx 28rpx rgba(91, 174, 146, 0.4); font-size: 28rpx; }
.fab:active { transform: scale(0.95); }

<!--pages/moment/publish.wxml-->
<view class="page">
  <view class="hero">
    <view class="hero-title">运动打卡 🏃</view>
    <view class="hero-sub">记录今天的好状态</view>
  </view>

  <view class="card">
    <!-- 内容 -->
    <textarea
      class="content"
      placeholder="今天运动了什么？写下你的心得吧"
      placeholder-class="placeholder"
      value="{{form.content}}"
      bindinput="onInput"
      data-field="content"
      maxlength="500"
      auto-height
    />
    <view class="content-counter">{{form.content.length}}/500</view>

    <!-- 图片网格 -->
    <view class="images">
      <view class="img-item" wx:for="{{form.images}}" wx:key="*this">
        <image class="img" src="{{item}}" mode="aspectFill"></image>
        <view class="img-del" bindtap="onDelImage" data-index="{{index}}">×</view>
      </view>
      <view class="img-add" wx:if="{{form.images.length < 9}}" bindtap="onPickImage">＋</view>
    </view>

    <view class="divider"></view>

    <!-- 运动项目 -->
    <view class="field field--column">
      <text class="field-label">运动项目</text>
      <view class="radio-group">
        <view wx:for="{{sportList}}" wx:key="value" class="radio-item {{form.sport === item.value ? 'radio-item--active' : ''}}" data-value="{{item.value}}" bindtap="onSelectSport">
          {{item.emoji}} {{item.label}}
        </view>
      </view>
    </view>

    <view class="divider"></view>

    <!-- 心情 -->
    <view class="field field--column">
      <text class="field-label">心情</text>
      <view class="radio-group">
        <view wx:for="{{moodList}}" wx:key="*this" class="mood-item {{form.mood === item ? 'mood-item--active' : ''}}" data-mood="{{item}}" bindtap="onSelectMood">{{item}}</view>
      </view>
    </view>

    <view class="divider"></view>

    <view class="field field--input">
      <text class="field-label">地点</text>
      <input class="field-input" placeholder="如：北校区体育馆（选填）" placeholder-class="placeholder" value="{{form.location}}" bindinput="onInput" data-field="location" maxlength="50" />
    </view>
  </view>

  <view class="bottom-spacer"></view>
  <view class="bottom-bar">
    <button class="btn-submit" bindtap="onSubmit" loading="{{submitting}}">发布动态</button>
  </view>
</view>

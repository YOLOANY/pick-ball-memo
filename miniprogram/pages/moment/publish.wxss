/* pages/moment/publish.wxss */
page { background-color: #F4F8F6; }
.page { padding-bottom: 40rpx; }

.hero { padding: 50rpx 40rpx 60rpx; background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; border-bottom-left-radius: 32rpx; border-bottom-right-radius: 32rpx; box-shadow: 0 8rpx 24rpx rgba(91, 174, 146, 0.18); }
.hero-title { font-size: 44rpx; font-weight: 600; letter-spacing: 2rpx; }
.hero-sub { margin-top: 12rpx; font-size: 26rpx; opacity: 0.92; }

.card { margin: 36rpx 32rpx 0; background-color: #ffffff; border-radius: 24rpx; padding: 28rpx 32rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.04); }

.content { width: 100%; min-height: 200rpx; font-size: 30rpx; color: #1F2A28; line-height: 1.6; }
.content-counter { text-align: right; font-size: 22rpx; color: #B0BBB8; margin-top: 8rpx; }
.placeholder { color: #B0BBB8; }

.images { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx; margin-top: 24rpx; }
.img-item { position: relative; width: 100%; height: 200rpx; border-radius: 12rpx; overflow: hidden; }
.img { width: 100%; height: 100%; }
.img-del { position: absolute; top: 4rpx; right: 4rpx; width: 40rpx; height: 40rpx; line-height: 36rpx; text-align: center; background-color: rgba(0,0,0,0.6); color: #ffffff; border-radius: 50%; font-size: 30rpx; }
.img-add { width: 100%; height: 200rpx; border-radius: 12rpx; background-color: #F4F8F6; color: #5BAE92; font-size: 60rpx; display: flex; align-items: center; justify-content: center; border: 2rpx dashed #C9DCD3; }

.divider { height: 2rpx; background-color: #EEF2F0; margin: 24rpx -32rpx; }

.field { display: flex; align-items: center; justify-content: space-between; padding: 16rpx 0; }
.field--column { flex-direction: column; align-items: stretch; }
.field--input { }
.field-label { font-size: 30rpx; color: #1F2A28; font-weight: 500; width: 100%; margin-bottom: 16rpx; }
.field-input { flex: 1; font-size: 30rpx; color: #1F2A28; text-align: right; }

.radio-group { display: flex; flex-wrap: wrap; gap: 16rpx; }
.radio-item { padding: 14rpx 24rpx; font-size: 26rpx; color: #6B7875; background-color: #F4F8F6; border-radius: 32rpx; border: 2rpx solid transparent; }
.radio-item--active { color: #3D8C72; background-color: #E8F4EE; border-color: #5BAE92; font-weight: 500; }
.mood-item { padding: 14rpx 24rpx; font-size: 40rpx; background-color: #F4F8F6; border-radius: 32rpx; border: 2rpx solid transparent; line-height: 1; }
.mood-item--active { background-color: #E8F4EE; border-color: #5BAE92; }

.bottom-spacer { height: 160rpx; }
.bottom-bar { position: fixed; left: 0; right: 0; bottom: 0; padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom)); background-color: #ffffff; box-shadow: 0 -4rpx 20rpx rgba(0,0,0,0.05); }
.btn-submit { height: 92rpx; line-height: 92rpx; background: linear-gradient(135deg, #5BAE92 0%, #7DC9A8 100%); color: #ffffff; font-size: 32rpx; font-weight: 500; border-radius: 46rpx; letter-spacing: 4rpx; box-shadow: 0 8rpx 20rpx rgba(91, 174, 146, 0.3); }
